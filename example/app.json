{
  "expo": {
    "name": "Country Picker Example",
    "description": "Expo example app for react-native-country-picker-modal",
    "slug": "country-picker-example",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xcarpentier.countrypickerexample"
    },
    "android": {
      "package": "com.xcarpentier.countrypickerexample",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-status-bar"]
  }
}
